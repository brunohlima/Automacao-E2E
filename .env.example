# URL de login da plataforma no ambiente de QA
BASE_URL=https://exemplo.com/login

# Credenciais do usuario administrador usado para logar nos testes
EMAIL=seu_email@exemplo.com
PASSWORD=sua_senha

# Senha atribuida ao usuario criado no teste de Nivel 2 (dependencia de dados)
USER_PASSWORD_NIVEL2=senha_do_usuario_criado

# Numero usado no cadastro de contato do teste de Nivel 4 (jornada do cliente)
TEST_PHONE=5511900000000
